# Copiar a .env.local con los datos del proyecto remoto de Supabase: los usa el build.
# Para desarrollar contra Supabase local, copiar a .env.development.local con los valores de
# `supabase status`: `pnpm dev` les da prioridad. Ninguno de los dos archivos se commitea.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
